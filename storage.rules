rules_version = '2';

// Fotos de perfumes. Dos carpetas por perfume:
//   perfumes-raw/{perfumeId}/...   subida original, sin procesar (privada)
//   perfumes/{perfumeId}/...       versión optimizada que sirve el sitio
//                                  público (la genera la Cloud Function de
//                                  resize, ver functions/src/index.ts — el
//                                  cliente nunca escribe acá directo)
//
// Subir fotos es exclusivo del Dueño (brief: el Empleado no toca fotos/
// ficha). Storage no tiene un Admin/Firestore lookup nativo como Firestore
// rules, pero sí puede llamar a `firestore.get()` (reglas v2) para el mismo
// chequeo de rol que usan firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function usuarioActivo() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.activo == true;
    }

    function esDueño() {
      return usuarioActivo()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'dueño';
    }

    function esImagenValida() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /perfumes-raw/{perfumeId}/{fileName} {
      allow read: if usuarioActivo();
      allow write: if esDueño() && esImagenValida();
      allow delete: if esDueño();
    }

    // Público: el catálogo (y la PWA, incluso sin login) necesita mostrar
    // las fotos optimizadas a cualquier visitante.
    match /perfumes/{perfumeId}/{fileName} {
      allow read: if true;
      allow write: if false; // solo la Cloud Function (Admin SDK)
    }
  }
}
